rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // Reels collection
    match /reels/{reelId} {
      allow read: if true;
      allow create, update: if (
        request.resource.data.title is string
        && request.resource.data.user is string
        && request.resource.data.videoUrl is string
      ) || (
        request.resource.data.keys().hasAll(['reportsCount', 'isAutoHidden'])
        && request.resource.data.reportsCount is number
        && request.resource.data.isAutoHidden is bool
      );
      allow delete: if false;
    }

    // Stories collection
    match /stories/{storyId} {
      allow read: if true;
      allow create, update: if request.resource.data.username is string;
      allow delete: if false;
    }

    // Posts collection
    match /posts/{postId} {
      allow read: if true;
      allow create, update: if request.resource.data.user is string
                            && request.resource.data.mediaUrl is string;
      allow delete: if false;
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if request.resource.data.username is string;
      allow delete: if false;
    }

    // In-app Feedback & Bug Reports collection
    match /feedback/{feedbackId} {
      allow read: if false;
      allow create: if isValidString(request.resource.data.message, 1, 5000)
                    && request.resource.data.category is string
                    && request.resource.data.username is string;
      allow update, delete: if false;
    }

    // Reel Moderation Reports collection
    match /reel_reports/{reportId} {
      allow read: if false;
      allow create, update: if isValidString(request.resource.data.reelId, 1, 200)
                            && isValidString(request.resource.data.reporterId, 1, 200)
                            && isValidString(request.resource.data.reason, 1, 500);
      allow delete: if false;
    }

    // Default connection test collection
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
